{
  "name": "idcard",
  "version": "0.23.1",
  "description": "Self-hosted ID card management, collection forms and printing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nirkriin-opensource/idcard-manager.git"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack && tsc -p tsconfig.server.json",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node dist/worker/main.js",
    "migrate": "tsx src/cli/main.ts migrate",
    "admin": "tsx src/cli/main.ts admin",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src tests next.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:integration",
    "package:source": "npm run package:production",
    "package:production": "tsx scripts/package-production.ts"
  },
  "dependencies": {
    "@bwip-js/node": "^4.11.4",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fontkit": "^2.0.4",
    "jsfeat": "0.0.8",
    "konva": "^10.0.0",
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.0.0",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "yauzl": "^3.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@playwright/test": "^1.56.0",
    "@types/archiver": "^8.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "embedded-postgres": "^16.14.0-beta.17",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zxing-wasm": "^3.1.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
